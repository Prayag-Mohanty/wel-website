# Copy this file to .env and fill it in. Never commit .env.

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# The first admin account, created the first time the app starts.
ADMIN_EMAIL=your-name@iitb.ac.in
ADMIN_PASSWORD=change-me-too

# Where the database lives. Leave unset for instance/inventory.db.
# Point it at a mounted volume on a server, e.g.
#   DATABASE_URL=sqlite:////var/lib/wel-inventory/inventory.db
# DATABASE_URL=

# Set to 1 once the app is served over HTTPS, so the session cookie is
# only ever sent over an encrypted connection.
# COOKIE_SECURE=1
